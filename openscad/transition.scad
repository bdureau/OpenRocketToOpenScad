/*
 * Transition (shoulder / boat tail / reducer) generated by ORKtoSCAD from an OpenRocket design.
 *
 * Units: mm. The aft end is at z = 0, the fore end at z = L. The aft shoulder hangs below z = 0,
 * the fore shoulder sticks out above z = L. The 2D half-profile is built first, then turned into
 * a solid with a single rotate_extrude().
 *
 * - The outer profile uses the same formulas as OpenRocket, including "clipped" shapes.
 * - The wall thickness is measured perpendicular to the surface (like OpenRocket), using offset().
 * - Rings of the shoulders' thickness join the shoulders to the wall, so the part is one solid.
 *
 * You can change the values below and re-render (F6) in OpenSCAD.
 */

shape   = "##shape##";               // conical | ogive | ellipsoid | power | parabolic | haack
L       = ##length##;                // length of the transition (without shoulders)
Rf      = ##foreradius##;            // radius at the fore (top) end
Ra      = ##aftradius##;             // radius at the aft (bottom) end
t       = ##thickness##;             // wall thickness, 0 = solid (filled)
p       = ##shapeparameter##;        // OpenRocket shape parameter (ogive, power, parabolic: 0..1, haack: 0..1/3)
clipped = ##shapeclipped##;          // OpenRocket "clipped" option (ellipsoid, power and haack only)

RsF     = ##foreshoulderradius##;    // fore shoulder outer radius (0 = no shoulder)
LsF     = ##foreshoulderlength##;
TsF     = ##foreshoulderthickness##;
cappedF = ##foreshouldercapped##;    // true = fore shoulder closed at the top

RsA     = ##aftshoulderradius##;     // aft shoulder outer radius (0 = no shoulder)
LsA     = ##aftshoulderlength##;
TsA     = ##aftshoulderthickness##;
cappedA = ##aftshouldercapped##;     // true = aft shoulder closed at the bottom

steps = 100;   // number of points along the profile (denser at both ends)
$fn   = 200;   // smoothness around the axis

// ---------------------------------------------------------------- OpenRocket shape formulas
// Radius at distance x from the tip of a shape of base radius r and length l (same as OpenRocket).

function ogive_r(x, r, l) =
    l < r ? ogive_r(x * r / l, r, r) :            // OpenRocket scales short ogives
    p < 0.001 ? r * x / l :
    let (rho = sqrt((l * l + r * r) * (pow((2 - p) * l, 2) + pow(p * r, 2)) / (4 * pow(p * r, 2))),
         lp  = l / p,
         y0  = sqrt(max(0, rho * rho - lp * lp)))
    sqrt(max(0, rho * rho - pow(lp - x, 2))) - y0;

// OpenSCAD trigonometry works in degrees: a is the angle theta of the Haack formula, in degrees.
function haack_r(x, r, l) =
    let (a = acos(max(-1, min(1, 1 - 2 * x / l))))
    r * sqrt(max(0, (a * PI / 180 - sin(2 * a) / 2 + p * pow(sin(a), 3)) / PI));

function shape_r(x, r, l) =
    shape == "conical"   ? r * x / l :
    shape == "ogive"     ? ogive_r(x, r, l) :
    shape == "ellipsoid" ? let (xx = x * r / l) sqrt(max(0, 2 * r * xx - xx * xx)) :
    shape == "power"     ? (p <= 0.00001 ? (x <= 0.00001 ? 0 : r) : r * pow(x / l, p)) :
    shape == "parabolic" ? r * ((2 * x / l - p * pow(x / l, 2)) / (2 - p)) :
    shape == "haack"     ? haack_r(x, r, l) :
    assert(false, str("Unknown transition shape: ", shape));

// ---------------------------------------------------------------- transition radius (OpenRocket's Transition.getRadius)

r1 = min(Rf, Ra);   // small end
r2 = max(Rf, Ra);   // large end
useClip = clipped && (shape == "ellipsoid" || shape == "power" || shape == "haack")
          && r1 > 0 && L > 0 && r1 != r2;

// Clip length: solve shape_r(c, r2, c + L) == r1 by bisection (OpenRocket's calculateClip, precision 0.1 mm).
function clipGrow(lo, hi, n) =
    (shape_r(hi, r2, hi + L) - r1 < 0 && n <= 10) ? clipGrow(hi, hi * 2, n + 1) : [lo, hi];
function clipSearch(lo, hi) =
    let (c = (lo + hi) / 2)
    (hi - lo) < 0.1 ? c :
    (shape_r(c, r2, c + L) - r1 > 0) ? clipSearch(lo, c) : clipSearch(c, hi);
clipLength = useClip ? let (b = clipGrow(0, L, 0)) clipSearch(b[0], b[1]) : 0;

function fromSmallEnd(x) =
    useClip ? shape_r(clipLength + x, r2, clipLength + L) : r1 + shape_r(x, r2 - r1, L);

// Radius at distance x from the fore end.
function radius(x) =
    x <= 0 ? Rf :
    x >= L ? Ra :
    Rf == Ra ? Rf :
    Rf > Ra ? fromSmallEnd(L - x) : fromSmallEnd(x);

// ---------------------------------------------------------------- 2D shapes (x = radius, y = height)

function xAt(i) = L * (1 - cos(180 * i / steps)) / 2;

// Full silhouette (both sides of the axis), extended beyond the open ends so that offset() leaves them open.
silhouette = concat(
    Rf > 0 ? [[Rf, L + t + 1]] : [],
    [for (i = [0 : steps]) [ radius(xAt(i)), L - xAt(i)]],
    [[Ra, -t - 1], [-Ra, -t - 1]],
    [for (i = [steps : -1 : 1]) [-radius(xAt(i)), L - xAt(i)]],
    Rf > 0 ? [[-radius(xAt(0)), L - xAt(0)], [-Rf, L + t + 1]] : []);

module solid2d() polygon(silhouette);

rMax = max([for (i = [0 : steps]) radius(xAt(i))]);

module body2d()
    intersection() {
        if (t > 0) difference() { solid2d(); offset(r = -t) solid2d(); }
        else solid2d();
        square([rMax + 1, L]);
    }

module aftShoulder2d() {
    translate([max(0, RsA - TsA), -LsA]) square([min(TsA, RsA), LsA]);
    if (cappedA) translate([0, -LsA]) square([RsA, min(TsA, LsA)]);
    if (t > 0) intersection() {
        solid2d();
        translate([max(0, RsA - TsA), 0]) square([Ra, min(TsA, L)]);
    }
}

module foreShoulder2d() {
    translate([max(0, RsF - TsF), L]) square([min(TsF, RsF), LsF]);
    if (cappedF) translate([0, L + LsF - min(TsF, LsF)]) square([RsF, min(TsF, LsF)]);
    if (t > 0) intersection() {
        solid2d();
        translate([max(0, RsF - TsF), L - min(TsF, L)]) square([Rf, min(TsF, L)]);
    }
}

rotate_extrude()
    union() {
        body2d();
        if (RsA > 0 && LsA > 0 && TsA > 0) aftShoulder2d();
        if (RsF > 0 && LsF > 0 && TsF > 0) foreShoulder2d();
    }
